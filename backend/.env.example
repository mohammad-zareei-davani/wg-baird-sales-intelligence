# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Narrative generation ---------------------------------------------------
# With a key present, the written parts of each report are generated for the
# dataset that is actually loaded. Without one, the system falls back to the
# built-in templates and keeps working, so the key is optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to "false" to force the built-in templates even when a key is present.
LLM_NARRATIVE_ENABLED=true

# Seconds to wait for the model before falling back to a template.
LLM_TIMEOUT_SECONDS=25

# --- Reporting assumptions --------------------------------------------------
# Planning rate used to convert Euro-billed work into the base currency.
BAIRD_EUR_GBP=0.86
